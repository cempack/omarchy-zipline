#!/bin/bash

# omarchy-zipline: upload the clipboard, Omarchy's screenshots and recordings,
# and files to a Zipline v4 server, then copy the link. It never captures the
# screen itself: Omarchy's Print key does that (and puts the image on the
# clipboard), this only uploads the result. The token is read from the config file
# and handed to curl through a header file descriptor, so it never appears in
# argv, the process list, or any output.

set -uo pipefail

VERSION="2.1.0"
CONFIG_FILE="${OMARCHY_ZIPLINE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-zipline/config}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-zipline"
HISTORY_FILE="$STATE_DIR/history.tsv"
# Chunked uploads run in a subshell; the progress notification id is handed
# back to the main shell through this file so the result can replace it.
PROGRESS_FILE="$STATE_DIR/progress.$$"

COPY=1
QUIET=0
EXPIRES_OVERRIDE=""
PROGRESS_ID=""

usage() {
  cat <<'EOF'
Usage: omarchy-zipline [options] <command> [args]

Commands:
  clipboard           Upload the clipboard: an image (such as the screenshot
                      Print just copied), copied files or text. A lone URL on
                      the clipboard is shortened instead
  file [path...]      Upload files (opens the file chooser without paths)
  recording           Upload the newest Omarchy screen recording
  last                Copy the most recent link again

More (for scripts):
  screenshot          Upload the newest screenshot Omarchy saved (Print)
  shorten [url]       Shorten a URL (defaults to the clipboard)
  history [count]     Print recent uploads as: url<TAB>kind<TAB>name<TAB>time
  status              Check the server URL and token
  server              Print the configured server URL (no network; exit 1 if unset)
  setup               Ask for the server URL and token and save them
  config-path         Print the config file path

Options:
  --expires <value>   Delete after a time: 1h, 7d, never or date=<ISO date>
  --no-copy           Do not copy the link to the clipboard
  --quiet             No desktop notifications (errors still go to stderr)
  -h, --help          Show this help
  --version           Print the version
EOF
}

die() {
  echo "omarchy-zipline: $*" >&2
  notify_error "$*"
  exit 1
}

have() {
  command -v "$1" >/dev/null 2>&1
}

# ---------------------------------------------------------------- config ---

config_value() {
  # KEY=value lines; surrounding quotes are stripped. The file is parsed, never
  # sourced, so a config file cannot run code.
  local key=$1 line value
  [[ -r $CONFIG_FILE ]] || return 1
  line=$(grep -E "^[[:space:]]*${key}=" "$CONFIG_FILE" | tail -n 1) || return 1
  value=${line#*=}
  value=${value%$'\r'}
  if [[ $value == \"*\" && ${#value} -ge 2 ]]; then
    value=${value:1:-1}
  elif [[ $value == \'*\' && ${#value} -ge 2 ]]; then
    value=${value:1:-1}
  fi
  printf '%s' "$value"
}

load_config() {
  ZIPLINE_URL=${ZIPLINE_URL:-$(config_value ZIPLINE_URL || true)}
  ZIPLINE_URL=${ZIPLINE_URL%/}
  ZIPLINE_FORMAT=${ZIPLINE_FORMAT:-$(config_value ZIPLINE_FORMAT || true)}
  ZIPLINE_EXPIRES=${ZIPLINE_EXPIRES:-$(config_value ZIPLINE_EXPIRES || true)}
  ZIPLINE_ORIGINAL_NAME=${ZIPLINE_ORIGINAL_NAME:-$(config_value ZIPLINE_ORIGINAL_NAME || true)}
  ZIPLINE_FOLDER=${ZIPLINE_FOLDER:-$(config_value ZIPLINE_FOLDER || true)}
  ZIPLINE_DOMAIN=${ZIPLINE_DOMAIN:-$(config_value ZIPLINE_DOMAIN || true)}
  ZIPLINE_CHUNK_MB=${ZIPLINE_CHUNK_MB:-$(config_value ZIPLINE_CHUNK_MB || true)}
  ZIPLINE_CHUNK_MB=${ZIPLINE_CHUNK_MB:-50}
  [[ $ZIPLINE_CHUNK_MB =~ ^[0-9]+$ ]] && ((ZIPLINE_CHUNK_MB > 0)) || ZIPLINE_CHUNK_MB=50
  [[ -n $EXPIRES_OVERRIDE ]] && ZIPLINE_EXPIRES=$EXPIRES_OVERRIDE
  return 0
}

token() {
  local value file
  if [[ -n ${ZIPLINE_TOKEN:-} ]]; then
    printf '%s' "$ZIPLINE_TOKEN"
    return 0
  fi
  value=$(config_value ZIPLINE_TOKEN || true)
  if [[ -z $value ]]; then
    file=$(config_value ZIPLINE_TOKEN_FILE || true)
    file=${file/#\~/$HOME}
    [[ -n $file && -r $file ]] && value=$(head -n 1 "$file")
  fi
  value=${value%$'\r'}
  printf '%s' "$value"
}

require_config() {
  load_config
  if [[ -z $ZIPLINE_URL ]]; then
    die "No server configured. Run: omarchy-zipline setup"
  fi
  if [[ ! $ZIPLINE_URL =~ ^https?:// ]]; then
    die "ZIPLINE_URL must start with https:// (got: $ZIPLINE_URL)"
  fi
  if [[ -z $(token) ]]; then
    die "No API token configured. Run: omarchy-zipline setup"
  fi
}

# ---------------------------------------------------------- notifications ---

take_progress_id() {
  if [[ -f $PROGRESS_FILE ]]; then
    PROGRESS_ID=$(cat "$PROGRESS_FILE" 2>/dev/null)
    rm -f "$PROGRESS_FILE"
  fi
}

notify() {
  # notify <headline> <body> [image] [url]
  ((QUIET)) && return 0
  local headline=$1 body=$2 image=${3:-} url=${4:-}
  take_progress_id
  if have omarchy-notification-send; then
    local args=(-g "󰅟")
    [[ -n $PROGRESS_ID ]] && args+=(-r "$PROGRESS_ID")
    [[ -n $image ]] && args+=(--image "$image")
    args+=("$headline" "$body")
    [[ -n $url ]] && args+=(--exec xdg-open "$url")
    omarchy-notification-send "${args[@]}" >/dev/null 2>&1 || true
  elif have notify-send; then
    local args=(-a "Zipline")
    [[ -n $image ]] && args+=(-i "$image")
    notify-send "${args[@]}" "$headline" "$body" >/dev/null 2>&1 || true
  fi
}

notify_progress() {
  # Re-uses one notification for chunked upload progress.
  ((QUIET)) && return 0
  have omarchy-notification-send || return 0
  local args=(-g "󰅟" -t 30000 -p)
  [[ -n $PROGRESS_ID ]] && args+=(-r "$PROGRESS_ID")
  local id
  id=$(omarchy-notification-send "${args[@]}" "Uploading to Zipline" "$1" 2>/dev/null | tail -n 1)
  if [[ $id =~ ^[0-9]+$ ]]; then
    PROGRESS_ID=$id
    mkdir -p "$STATE_DIR"
    printf '%s' "$id" >"$PROGRESS_FILE"
  fi
  return 0
}

notify_error() {
  ((QUIET)) && return 0
  take_progress_id
  if have omarchy-notification-send; then
    local args=(-g "󰅟" -u critical)
    [[ -n $PROGRESS_ID ]] && args+=(-r "$PROGRESS_ID")
    omarchy-notification-send "${args[@]}" "Zipline upload failed" "$1" >/dev/null 2>&1 || true
  elif have notify-send; then
    notify-send -a "Zipline" -u critical "Zipline upload failed" "$1" >/dev/null 2>&1 || true
  fi
}

# ------------------------------------------------------------------- http ---

# Prints one header per line; curl reads them from a file descriptor (-H @fd)
# so the token never reaches argv.
auth_headers() {
  printf 'authorization: %s\n' "$(token)"
  printf 'user-agent: omarchy-zipline/%s\n' "$VERSION"
}

upload_headers() {
  auth_headers
  [[ -n $ZIPLINE_FORMAT ]] && printf 'x-zipline-format: %s\n' "$ZIPLINE_FORMAT"
  [[ -n $ZIPLINE_EXPIRES ]] && printf 'x-zipline-deletes-at: %s\n' "$ZIPLINE_EXPIRES"
  [[ $ZIPLINE_ORIGINAL_NAME == true ]] && printf 'x-zipline-original-name: true\n'
  [[ -n $ZIPLINE_FOLDER ]] && printf 'x-zipline-folder: %s\n' "$ZIPLINE_FOLDER"
  [[ -n $ZIPLINE_DOMAIN ]] && printf 'x-zipline-domain: %s\n' "$ZIPLINE_DOMAIN"
  return 0
}

api_error() {
  # Best-effort message from a Zipline error body.
  local body=$1 status=$2 message
  message=$(jq -r '.error // .message // empty' <<<"$body" 2>/dev/null)
  if [[ -z $message ]]; then
    case $status in
      000) message="Could not reach $ZIPLINE_URL" ;;
      401 | 403) message="The server refused the token (HTTP $status)" ;;
      413) message="File too large for the server or proxy (HTTP 413). Lower ZIPLINE_CHUNK_MB" ;;
      *) message="HTTP $status from $ZIPLINE_URL" ;;
    esac
  fi
  printf '%s' "$message"
}

# curl_json <outvar-body> <outvar-status> <curl args...>
curl_call() {
  local -n _body=$1 _status=$2
  shift 2
  local tmp
  tmp=$(mktemp)
  _status=$(curl -sS -o "$tmp" -w '%{http_code}' --connect-timeout 15 "$@" 2>/dev/null) || true
  _body=$(cat "$tmp")
  rm -f "$tmp"
  [[ -n $_status ]] || _status=000
}

quote_form_value() {
  # curl -F accepts double-quoted values with \" and \\ escapes.
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  printf '"%s"' "$value"
}

mime_of() {
  local mime
  mime=$(file --brief --mime-type -- "$1" 2>/dev/null)
  printf '%s' "${mime:-application/octet-stream}"
}

uri_encode() {
  jq -rn --arg s "$1" '$s|@uri'
}

# upload_file <path> <name> -> prints URL
upload_file() {
  local path=$1 name=$2 size chunk_bytes mime
  [[ -f $path ]] || die "Not a file: $path"
  size=$(stat -c %s -- "$path")
  chunk_bytes=$((ZIPLINE_CHUNK_MB * 1024 * 1024))
  mime=$(mime_of "$path")
  if ((size > chunk_bytes)); then
    upload_chunked "$path" "$name" "$size" "$chunk_bytes" "$mime"
    return
  fi

  local body status url
  curl_call body status -X POST \
    -H @<(upload_headers) \
    -F "file=@$(quote_form_value "$path");filename=$(quote_form_value "$name");type=$mime" \
    "$ZIPLINE_URL/api/upload"
  if [[ $status != 200 ]]; then
    die "$(api_error "$body" "$status")"
  fi
  url=$(jq -r '.files[0].url // empty' <<<"$body" 2>/dev/null)
  [[ -n $url ]] || die "The server did not return a link"
  printf '%s\n' "$url"
}

# Zipline's /api/upload/partial: sequential chunks, each one carrying the
# single-use partialToken returned by the previous chunk. Keeps every request
# under proxy body limits (Cloudflare caps proxied requests at 100 MB).
upload_chunked() {
  local path=$1 name=$2 total=$3 chunk_bytes=$4 mime=$5
  local start=0 end last ptoken="" body status tmp encoded url
  tmp=$(mktemp)
  # Runs in a command substitution, so EXIT covers both success and die().
  CHUNK_TMP=$tmp
  trap 'rm -f -- "${CHUNK_TMP:-}"' EXIT
  encoded=$(uri_encode "$name")

  while ((start < total)); do
    end=$((start + chunk_bytes - 1))
    ((end >= total)) && end=$((total - 1))
    last=false
    ((end == total - 1)) && last=true

    dd if="$path" of="$tmp" bs=1M iflag=skip_bytes,count_bytes \
      skip="$start" count=$((end - start + 1)) status=none ||
      die "Could not read $path"

    notify_progress "$name — $((start * 100 / total))%"

    curl_call body status -X POST \
      -H @<(
        upload_headers
        printf 'content-range: bytes %s-%s/%s\n' "$start" "$end" "$total"
        printf 'x-zipline-p-filename: %s\n' "$encoded"
        printf 'x-zipline-p-content-type: %s\n' "$mime"
        printf 'x-zipline-p-content-length: %s\n' "$total"
        printf 'x-zipline-p-lastchunk: %s\n' "$last"
        [[ -n $ptoken ]] && printf 'x-zipline-p-token: %s\n' "$ptoken"
      ) \
      -F "file=@$(quote_form_value "$tmp");filename=\"chunk\";type=application/octet-stream" \
      "$ZIPLINE_URL/api/upload/partial"

    if [[ $status != 200 ]]; then
      die "$(api_error "$body" "$status")"
    fi
    ptoken=$(jq -r '.partialToken // empty' <<<"$body" 2>/dev/null)
    start=$((end + 1))
  done

  url=$(jq -r '.files[0].url // empty' <<<"$body" 2>/dev/null)
  [[ -n $url ]] || die "The server did not return a link"
  printf '%s\n' "$url"
}

shorten_url() {
  local destination=$1 body status url
  curl_call body status -X POST \
    -H @<(auth_headers) \
    -H 'content-type: application/json' \
    --data-binary "$(jq -cn --arg d "$destination" '{destination: $d}')" \
    "$ZIPLINE_URL/api/user/urls"
  if [[ $status != 200 ]]; then
    die "$(api_error "$body" "$status")"
  fi
  url=$(jq -r '.url // empty' <<<"$body" 2>/dev/null)
  [[ -n $url ]] || die "The server did not return a short link"
  printf '%s\n' "$url"
}

# ------------------------------------------------------------- reporting ---

record() {
  # record <url> <kind> <name> [image]
  local url=$1 kind=$2 name=$3 image=${4:-}
  mkdir -p "$STATE_DIR"
  (
    umask 077
    printf '%s\t%s\t%s\t%s\n' "$url" "$kind" "${name//$'\t'/ }" "$(date -Iseconds)" >>"$HISTORY_FILE"
  )
  if ((COPY)); then
    printf '%s' "$url" | wl-copy 2>/dev/null || true
  fi
  printf '%s\n' "$url"
  local headline
  if [[ $kind == shorten ]]; then
    headline="Short link created"
    ((COPY)) && headline="Short link copied"
  else
    headline="Uploaded"
    ((COPY)) && headline="Link copied"
  fi
  notify "$headline" "$url" "$image" "$url"
}

is_image() {
  [[ $(mime_of "$1") == image/* ]]
}

upload_and_record() {
  # upload_and_record <path> <kind> [name]
  local path=$1 kind=$2 name=${3:-} url image=""
  [[ -n $name ]] || name=$(basename -- "$path")
  url=$(upload_file "$path" "$name") || exit 1
  is_image "$path" && image=$path
  record "$url" "$kind" "$name" "$image"
}

# --------------------------------------------------------------- commands ---

# Same lookup as omarchy-capture-screenshot: OMARCHY_SCREENSHOT_DIR, then the
# XDG Pictures dir, then ~/Pictures.
screenshots_dir() {
  local dir=""
  [[ -f ~/.config/user-dirs.dirs ]] && dir=$(
    # shellcheck disable=SC1090
    source ~/.config/user-dirs.dirs >/dev/null 2>&1
    printf '%s' "${XDG_PICTURES_DIR:-}"
  )
  printf '%s' "${OMARCHY_SCREENSHOT_DIR:-${dir:-$HOME/Pictures}}"
}

newest_screenshot() {
  find "$(screenshots_dir)" -maxdepth 1 -type f \( -name 'screenshot-*.png' -o -name 'screenshot-*.jpg' \
    -o -name 'screenshot-*.jpeg' -o -name 'screenshot-*.webp' \) \
    -printf '%T@\t%p\n' 2>/dev/null | sort -rn | head -n 1 | cut -f2-
}

cmd_screenshot() {
  require_config
  local latest
  latest=$(newest_screenshot)
  [[ -n $latest ]] || die "No screenshots found in $(screenshots_dir). Take one with Print first"
  upload_and_record "$latest" screenshot
}

recordings_dir() {
  local dir=""
  [[ -f ~/.config/user-dirs.dirs ]] && dir=$(
    # shellcheck disable=SC1090
    source ~/.config/user-dirs.dirs >/dev/null 2>&1
    printf '%s' "${XDG_VIDEOS_DIR:-}"
  )
  printf '%s' "${OMARCHY_SCREENRECORD_DIR:-${dir:-$HOME/Videos}}"
}

cmd_recording() {
  require_config
  local dir latest
  dir=$(recordings_dir)
  latest=$(find "$dir" -maxdepth 1 -type f -name 'screenrecording-*.mp4' ! -name '*-processed.mp4' \
    -printf '%T@\t%p\n' 2>/dev/null | sort -rn | head -n 1 | cut -f2-)
  [[ -n $latest ]] || die "No screen recordings found in $dir"
  if pgrep -f '^gpu-screen-recorder' >/dev/null 2>&1; then
    die "A screen recording is still running. Stop it first (Alt + Print)"
  fi
  upload_and_record "$latest" recording
}

cmd_file() {
  require_config
  local files=() picked status=0
  if (($# > 0)); then
    files=("$@")
  elif have omarchy-file-select; then
    picked=$(omarchy-file-select --title "Upload to Zipline" --multiple) || status=$?
    ((status > 1)) && die "The file chooser did not open"
    [[ -n $picked ]] || exit 0
    readarray -t files <<<"$picked"
  else
    die "Pass one or more file paths"
  fi
  local f
  for f in "${files[@]}"; do
    [[ -n $f ]] || continue
    upload_and_record "$f" file
  done
}

decode_file_uri() {
  local uri=$1
  uri=${uri%$'\r'}
  [[ $uri == file://* ]] || return 1
  uri=${uri#file://}
  uri=${uri#localhost}
  printf '%b' "${uri//%/\\x}"
}

cmd_clipboard() {
  require_config
  have wl-paste || die "wl-paste is not installed"
  local types tmp ext mime text path
  types=$(wl-paste --list-types 2>/dev/null) || die "The clipboard is empty"

  if grep -qx 'text/uri-list' <<<"$types"; then
    local uploaded=0 line
    while IFS= read -r line; do
      path=$(decode_file_uri "$line") || continue
      [[ -f $path ]] || continue
      upload_and_record "$path" file
      uploaded=1
    done < <(wl-paste --type text/uri-list 2>/dev/null)
    ((uploaded)) && return 0
  fi

  mime=$(grep -m1 '^image/' <<<"$types" || true)
  if [[ -n $mime ]]; then
    ext=${mime#image/}
    ext=${ext%%+*}
    [[ $ext == jpeg ]] && ext=jpg
    tmp="${XDG_RUNTIME_DIR:-/tmp}/zipline-clipboard-$(date +'%Y-%m-%d_%H-%M-%S').$ext"
    wl-paste --type "$mime" >"$tmp" 2>/dev/null || die "Could not read the clipboard image"
    # Right after Print the clipboard holds the screenshot Omarchy also saved:
    # upload that file instead, so the link keeps its screenshot-<date> name.
    local shot
    shot=$(newest_screenshot)
    if [[ -n $shot ]] && have cmp && cmp -s -- "$tmp" "$shot"; then
      rm -f "$tmp"
      upload_and_record "$shot" screenshot
      return 0
    fi
    upload_and_record "$tmp" clipboard "$(basename -- "$tmp" | sed 's/^zipline-//')"
    # Keep the file for the notification image, then clean up.
    (sleep 30 && rm -f "$tmp") >/dev/null 2>&1 &
    return 0
  fi

  text=$(wl-paste --no-newline 2>/dev/null) || die "The clipboard is empty"
  [[ -n $text ]] || die "The clipboard is empty"
  if [[ $text =~ ^https?://[^[:space:]]+$ ]]; then
    local short
    short=$(shorten_url "$text") || exit 1
    record "$short" shorten "$text"
    return 0
  fi
  tmp="${XDG_RUNTIME_DIR:-/tmp}/clipboard-$(date +'%Y-%m-%d_%H-%M-%S').txt"
  (umask 077 && printf '%s\n' "$text" >"$tmp")
  upload_and_record "$tmp" clipboard
  rm -f "$tmp"
}

cmd_shorten() {
  require_config
  local destination=${1:-} short
  if [[ -z $destination ]]; then
    destination=$(wl-paste --no-newline 2>/dev/null || true)
  fi
  destination=${destination//[[:space:]]/}
  [[ $destination =~ ^https?://[^[:space:]]+$ ]] || die "No URL to shorten (copy a link first)"
  short=$(shorten_url "$destination") || exit 1
  record "$short" shorten "$destination"
}

cmd_last() {
  [[ -s $HISTORY_FILE ]] || die "Nothing uploaded yet"
  local url
  url=$(tail -n 1 "$HISTORY_FILE" | cut -f1)
  printf '%s' "$url" | wl-copy 2>/dev/null || true
  printf '%s\n' "$url"
  notify "Link copied" "$url" "" "$url"
}

cmd_history() {
  local count=${1:-10}
  [[ $count =~ ^[0-9]+$ ]] || count=10
  [[ -s $HISTORY_FILE ]] || return 0
  tail -n "$count" "$HISTORY_FILE" | tac
}

cmd_server() {
  load_config
  [[ -n $ZIPLINE_URL && -n $(token) ]] || return 1
  printf '%s\n' "$ZIPLINE_URL"
}

cmd_status() {
  load_config
  if [[ -z $ZIPLINE_URL ]]; then
    echo "Not configured. Run: omarchy-zipline setup"
    return 1
  fi
  echo "Server: $ZIPLINE_URL"
  echo "Config: $CONFIG_FILE"
  if [[ -z $(token) ]]; then
    echo "Token:  missing"
    return 1
  fi
  local body status user
  curl_call body status -H @<(auth_headers) "$ZIPLINE_URL/api/user"
  if [[ $status == 200 ]]; then
    user=$(jq -r '.user.username // empty' <<<"$body" 2>/dev/null)
    echo "Token:  valid${user:+ (signed in as $user)}"
    return 0
  fi
  echo "Token:  rejected — $(api_error "$body" "$status")"
  return 1
}

write_config() {
  # write_config <url> <token>
  local url=$1 tok=$2 dir
  dir=$(dirname -- "$CONFIG_FILE")
  mkdir -p "$dir"
  chmod 700 "$dir"
  local tmp
  tmp=$(mktemp "$dir/.config.XXXXXX")
  chmod 600 "$tmp"
  {
    echo "# omarchy-zipline configuration (keep this file private: chmod 600)"
    echo "ZIPLINE_URL=$url"
    echo "ZIPLINE_TOKEN=$tok"
    echo
    echo "# Optional:"
    echo "# ZIPLINE_TOKEN_FILE=~/.secrets/zipline-token   # read the token from a file instead"
    echo "# ZIPLINE_FORMAT=random                          # random, uuid, date, name, gfycat, random-words"
    echo "# ZIPLINE_EXPIRES=7d                             # 1h, 7d, never, date=2027-01-01"
    echo "# ZIPLINE_ORIGINAL_NAME=true                     # keep the original file name on downloads"
    echo "# ZIPLINE_FOLDER=<folder id>                     # upload into a folder"
    echo "# ZIPLINE_DOMAIN=files.example.com               # return links on another configured domain"
    echo "# ZIPLINE_CHUNK_MB=50                            # files larger than this upload in chunks"
  } >"$tmp"
  if [[ -f $CONFIG_FILE ]]; then
    # Keep the optional settings someone already set.
    grep -E '^(ZIPLINE_FORMAT|ZIPLINE_EXPIRES|ZIPLINE_ORIGINAL_NAME|ZIPLINE_FOLDER|ZIPLINE_DOMAIN|ZIPLINE_CHUNK_MB|ZIPLINE_TOKEN_FILE)=' \
      "$CONFIG_FILE" >>"$tmp" || true
  fi
  mv -f "$tmp" "$CONFIG_FILE"
}

cmd_setup() {
  local url tok current
  load_config
  current=${ZIPLINE_URL:-}
  echo "Zipline setup — the token is in Zipline under your avatar > Copy token."
  echo
  if have gum; then
    url=$(gum input --placeholder "https://zipline.example.com" --value "$current" --header "Server URL") || exit 130
    tok=$(gum input --password --placeholder "Paste the API token" --header "API token (leave empty to keep the current one)") || exit 130
  else
    read -r -p "Server URL [${current:-https://zipline.example.com}]: " url
    url=${url:-$current}
    read -r -s -p "API token (leave empty to keep the current one): " tok
    echo
  fi
  url=${url%/}
  [[ $url =~ ^https?://[^[:space:]]+$ ]] || die "That doesn't look like a URL: $url"
  [[ -n $tok ]] || tok=$(token)
  [[ -n $tok ]] || die "A token is required"
  write_config "$url" "$tok"
  echo "Saved to $CONFIG_FILE (mode 600)."
  echo
  ZIPLINE_URL="" ZIPLINE_TOKEN="" cmd_status
}

# ------------------------------------------------------------------- main ---

main() {
  local args=()
  while (($# > 0)); do
    case $1 in
      --no-copy) COPY=0 ;;
      --quiet) QUIET=1 ;;
      --expires)
        EXPIRES_OVERRIDE=${2:-}
        shift
        ;;
      --expires=*) EXPIRES_OVERRIDE=${1#*=} ;;
      -h | --help)
        usage
        return 0
        ;;
      --version)
        echo "omarchy-zipline $VERSION"
        return 0
        ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  set -- "${args[@]}"

  local command=${1:-}
  (($# > 0)) && shift
  case $command in
    screenshot | shot) cmd_screenshot "$@" ;;
    recording | record | video) cmd_recording "$@" ;;
    file | files | upload) cmd_file "$@" ;;
    clipboard | clip | paste) cmd_clipboard "$@" ;;
    shorten | short | url) cmd_shorten "$@" ;;
    last) cmd_last ;;
    history) cmd_history "$@" ;;
    status) cmd_status ;;
    server) cmd_server ;;
    setup | configure | login) cmd_setup ;;
    config-path) echo "$CONFIG_FILE" ;;
    "")
      usage
      return 1
      ;;
    *)
      echo "omarchy-zipline: unknown command: $command" >&2
      usage >&2
      return 1
      ;;
  esac
}

main "$@"
